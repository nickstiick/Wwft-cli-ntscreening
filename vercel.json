{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/screen.js": {
      "maxDuration": 30
    },
    "api/v1.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1/screen", "destination": "/api/v1" },
    { "source": "/api/v1/screenings", "destination": "/api/v1" },
    { "source": "/api/checkout", "destination": "/api/payment" },
    { "source": "/api/webhook", "destination": "/api/payment" },
    { "source": "/api/kvk-mutatie", "destination": "/api/hercheck" },
    { "source": "/screener", "destination": "/screener.html" },
    { "source": "/betaald", "destination": "/betaald.html" },
    { "source": "/privacy-technisch", "destination": "/privacy-technisch.html" },
    { "source": "/privacy", "destination": "/privacy-technisch.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/vergelijk", "destination": "/vergelijk.html" },
    { "source": "/wwft-checklist", "destination": "/wwft-checklist.html" },
    { "source": "/klein-kantoor", "destination": "/klein-kantoor.html" }
  ]
}
