{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/screen.js": {
      "maxDuration": 30
    },
    "api/v1-screen.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1/screen", "destination": "/api/v1-screen" },
    { "source": "/api/v1/screenings", "destination": "/api/v1-screenings" },
    { "source": "/screener", "destination": "/screener.html" },
    { "source": "/betaald", "destination": "/betaald.html" },
    { "source": "/privacy-technisch", "destination": "/privacy-technisch.html" },
    { "source": "/privacy", "destination": "/privacy-technisch.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "crons": [
    {
      "path": "/api/hercheck?secret=${ADMIN_SECRET}",
      "schedule": "0 8 * * *"
    }
  ]
}
