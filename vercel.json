{
  "github": {
    "enabled": true
  },
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "api/rapport.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/screen.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/screener", "dest": "/public/screener.html" },
    { "src": "/betaald", "dest": "/public/betaald.html" },
    { "src": "/privacy-technisch", "dest": "/public/privacy-technisch.html" },
    { "src": "/privacy", "dest": "/public/privacy-technisch.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
